# --- Python environment (rebuild with: python3 -m venv venv; pip install telethon)
venv/
__pycache__/
*.pyc

# --- bridge runtime artifacts (regenerated every run; session holds auth state)
bridge/bridge.log
bridge/bridge.pid
bridge/*.session
bridge/*.session-journal

# --- compiled EA binaries (build stays in the MT5 project, never in git) ---
*.ex4
*.ex5

# --- editor / OS noise ---
*.swp
*~
.DS_Store

# --- local credential overrides (real values stay off the public repo) ---
bridge/config.local.properties
